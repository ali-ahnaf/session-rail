{
  "permissions": {
    "deny": [
      "Bash(git rebase:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env*)",
      "Read(./cert/**)",
      "Read(./firebase-admin-sdk-key/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/credentials*)",
      "Read(./**/secrets*)",
      "Read(~/.ssh/**)",
      "Edit(/.env)",
      "Read(~/.aws/**)",
      "Bash(npm publish*)",
      "Bash(npm install -g*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in */packages/*) npx prettier --write --ignore-unknown \"$f\";; esac; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Running prettier"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in */packages/shared/src/*) echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"packages/shared/src changed - run npm run build:shared before using compiled output.\"}}';; esac; } 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "ponytail@ponytail": true,
    "claude-md-management@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": true,
    "code-simplifier@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "juliusbrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "autoMemoryEnabled": false
}
